# Self-host: leave blank. One company is picked automatically after Studio signup.
# A second company: paste both from Studio → Settings → Keys and restart.
NEXT_PUBLIC_CLIENT_KEY_SECRET=
NEXT_PUBLIC_CLIENT_ID=
# Required for local sling-api; omit to use default hosted API URL from sling-core
NEXT_PUBLIC_API_URL=http://localhost:10001

# Same secret as API SLING_PREVIEW_INIT_SECRET — enables <slug>.preview.* host bootstrap via /api/fe-bootstrap
# SLING_PREVIEW_INIT_SECRET=
# PREVIEW_FRONTEND_BASE_DOMAIN=sling.biz
